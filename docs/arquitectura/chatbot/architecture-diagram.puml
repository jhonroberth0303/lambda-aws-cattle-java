@startuml Cattle-Bedrock-C4-System
title Cattle-Bedrock System Architecture (C4 Level 1)
caption AWS Serverless Spring Boot 3 API with Amazon Bedrock

rectangle "AWS Cloud" {
    rectangle "API Layer" {
        card apigw [
            🌐 API Gateway
            ---
            REST API
            Proxy Pattern {proxy+}
        ]
    }

    rectangle "Compute" {
        card lambda [
            λ AWS Lambda
            ---
            Java 21
            512MB
            30 seconds
        ]
    }

    rectangle "Data Layer" {
        card dynamodb [
            💾 DynamoDB
            ---
            Bovines
            Milking
            Pastures
            Tasks
            Plans
        ]
    }

    rectangle "AI & ML" {
        card bedrock [
            🤖 Amazon Bedrock
            ---
            Claude 3 Haiku
            anthropic.claude-3-haiku
            v1:0
        ]
    }

    rectangle "Monitoring" {
        card cw [
            📊 CloudWatch
            ---
            Logs
            Metrics
            Events
        ]
    }

    rectangle "Security" {
        card iam [
            🔐 IAM Role
            ---
            cattle-bedrock-lambda-role
            Bedrock + DynamoDB
        ]
    }
}

rectangle "Client" {
    actor client as "REST Client"
}

client --> apigw : HTTP Request\nPOST /chat
apigw --> lambda : Invoke
iam -.-> lambda : AssumeRole
lambda --> dynamodb : Query/Update
lambda --> bedrock : InvokeModel
lambda --> cw : Logs & Metrics
apigw <-- lambda : Response
client <-- apigw : HTTP 200 OK

@enduml

@enduml

@startuml Cattle-Bedrock-C4-Containers
title Cattle-Bedrock Container Architecture (C4 Level 2)
caption Lambda Function with Spring Boot Components

rectangle "AWS Lambda Container" {
    rectangle "Handler Layer" {
        package "entry" {
            component StreamLambdaHandler as handler
        }
    }

    rectangle "Spring Boot Layer" {
        package "spring" {
            component SpringBootApplication as springApp
            component CorsConfig as cors
            component RepositoryConfig as repoConfig
        }
    }

    rectangle "Web Layer (MVC)" {
        package "controllers" {
            component ChatbotController as controller
        }
    }

    rectangle "Business Logic Layer" {
        package "services" {
            component ChatbotService as service
            component EventBuilder as builder
        }
    }

    rectangle "Data Access Layer" {
        package "repositories" {
            component BovineRepository as bovRepo
            component MilkingRepository as milkRepo
            component PastureRepository as pastRepo
        }
    }

    rectangle "Transfer Objects" {
        package "dtos" {
            component ChatDTO as chatDto
            component BovineDTO as bovDto
            component MilkingDTO as milkDto
        }
    }
}

rectangle "External Services" {
    component "💾 DynamoDB" as dynamodb
    component "🤖 Amazon Bedrock" as bedrock
    component "📊 CloudWatch" as cw
}

handler --> springApp : Initialize
springApp --> cors : Configure
springApp --> repoConfig : Configure
springApp --> controller : Route

controller --> service : Call
service --> builder : Build Prompts
service --> bovRepo : Query Data
service --> milkRepo : Query Data
service --> pastRepo : Query Data

bovRepo --> dynamodb : CRUD
milkRepo --> dynamodb : CRUD
pastRepo --> dynamodb : CRUD

service --> chatDto : Transform
service --> bedrock : InvokeModel

service --> cw : Emit Logs
dynamodb --> cw : Emit Metrics

@enduml

@enduml

@startuml Cattle-Bedrock-Sequence
title Chat Request Processing Flow

actor Client
participant "API Gateway" as apigw
participant "Lambda Handler" as handler
participant "Spring Boot" as spring
participant "ChatbotController" as ctrl
participant "ChatbotService" as svc
participant "Repositories" as repo
participant "DynamoDB" as db
participant "Amazon Bedrock" as bedrock
participant "CloudWatch" as cw

Client ->> apigw: POST /chat\n{userMessage, context}
apigw ->> handler: Invoke Lambda
handler ->> spring: Initialize Context
spring ->> ctrl: Route Request
ctrl ->> svc: processMessage(request)

svc ->> repo: Query Bovines/Milking/Pastures
repo ->> db: Scan/Query
db -->> repo: Return Data
repo -->> svc: Return Domain Objects

svc ->> svc: Transform to DTOs
svc ->> svc: Build AI Prompt

svc ->> bedrock: InvokeModel\n(Claude 3 Haiku)
bedrock -->> svc: AI Generated Response

svc ->> svc: Parse Response
svc ->> svc: Build Response DTO

svc ->> cw: Emit Log Entry
svc ->> cw: Emit Metrics

svc -->> ctrl: Return ResponseDTO
ctrl -->> apigw: HTTP 200 OK
apigw -->> Client: {responseMessage, metadata}

cw ->> cw: Store Logs

@enduml

