@startuml Cattle-Integrated-Chatbot-System
title Chatbot Integrado - Vista de Sistema
caption El módulo Bedrock forma parte de cattle-lambda-function

actor Usuario as user
rectangle "cattle-front" as front
rectangle "API Gateway" as apigw
rectangle "AWS Lambda: cattle-lambda-function" as lambda
rectangle "ChatbotController" as controller
rectangle "Servicios de consulta\nBovine / Milking / Pasture" as query
database "DynamoDB" as ddb
cloud "Amazon Bedrock Runtime" as bedrock
cloud "Bedrock Knowledge Base" as kb

user --> front
front --> apigw : POST /api/chat/message\nPOST /api/chat/knowledge
apigw --> lambda
lambda --> controller
controller --> query : contexto de finca
query --> ddb
controller --> bedrock : generación de respuesta
controller --> kb : RetrieveAndGenerate

@enduml

@startuml Cattle-Integrated-Chatbot-Containers
title Chatbot Integrado - Componentes Principales

package "Lambda / Spring Boot" {
  [StreamLambdaHandler]
  [Application]
  [ChatbotController]
  [ChatbotService]
  [IntentDetectionService]
  [ContextBuilderService]
  [KnowledgeBaseService]
  [BedrockService]
  [RateLimitingService]
  [InputValidationService]
  [AuditLoggingService]
}

[StreamLambdaHandler] --> [Application]
[Application] --> [ChatbotController]
[ChatbotController] --> [ChatbotService]
[ChatbotController] --> [KnowledgeBaseService]
[ChatbotController] --> [RateLimitingService]
[ChatbotController] --> [InputValidationService]
[ChatbotController] --> [AuditLoggingService]
[ChatbotService] --> [IntentDetectionService]
[ChatbotService] --> [ContextBuilderService]
[ChatbotService] --> [BedrockService]

@enduml

@startuml Cattle-Integrated-Chatbot-Sequence
title Chatbot Integrado - Flujo de Consulta Operativa

actor Usuario as user
participant "cattle-front" as front
participant "ChatbotController" as ctrl
participant "ChatbotService" as svc
participant "IntentDetectionService" as intent
participant "ContextBuilderService" as context
participant "Servicios de consulta" as query
participant "DynamoDB" as db
participant "BedrockService" as bedrock

user -> front : pregunta del usuario
front -> ctrl : POST /api/chat/message
ctrl -> svc : chat(farmId, request)
svc -> intent : detectIntent(...)
svc -> context : buildContext(...)
context -> query : agregados y detalle
query -> db : query/scan
db --> query : datos
query --> context : contexto estructurado
svc -> bedrock : invokeModel(prompt enriquecido)
bedrock --> svc : respuesta
svc --> ctrl : ChatResponseDTO
ctrl --> front : HTTP 200

@enduml