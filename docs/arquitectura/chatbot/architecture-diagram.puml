@startuml Cattle-Bedrock-Class-Diagram
title Class Diagram - Key Classes

class StreamLambdaHandler {
    - handler: SpringBootLambdaContainerHandler
    + handleRequest(input, context): ApiGatewayResponse
}

class Application {
    - main(args: String[]): void
}

class ChatbotController {
    - chatbotService: ChatbotService
    + chat(request: ChatDTO): ResponseEntity<ResponseDTO>
    + health(): ResponseEntity<HealthDTO>
}

class ChatbotService {
    - bovineRepository: BovineRepository
    - milkingRepository: MilkingRepository
    - pastureRepository: PastureRepository
    - bedrockClient: BedrockRuntimeClient
    + processMessage(chatDTO): ResponseDTO
    - buildPrompt(context): String
    - invokeBedrockModel(prompt): String
    - parseResponse(response): String
}

class BovineRepository {
    - dynamoDbClient: DynamoDbClient
    + findAll(): List<Bovine>
    + findById(id): Bovine
    + save(bovine): Bovine
}

class ChatDTO {
    - userMessage: String
    - context: Map<String, Object>
}

class ResponseDTO {
    - responseMessage: String
    - metadata: Map<String, Object>
    - timestamp: LocalDateTime
}

class CorsConfig {
    + corsConfigurationSource(): CorsConfigurationSource
}

class RepositoryConfig {
    + dynamoDbClient(): DynamoDbClient
    + bedrockClient(): BedrockRuntimeClient
}

StreamLambdaHandler --> Application
Application --> ChatbotController
ChatbotController --> ChatbotService
ChatbotController --> ChatDTO
ChatbotController --> ResponseDTO
ChatbotService --> BovineRepository
ChatbotService --> "3" Repository
ChatbotService -.-> BedrockRuntimeClient : uses
BovineRepository -.-> Bovine : manages
RepositoryConfig --> DynamoDbClient
RepositoryConfig --> BedrockRuntimeClient

@enduml

